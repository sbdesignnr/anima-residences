# ── Kontaktný formulár (/kontakt → /api/kontakt) ─────────────────────────────
# Bez týchto dvoch premenných formulár NEODOSIELA a čestne to povie návštevníkovi
# (HTTP 501) — radšej než aby dopyt ticho zmizol do „ďakujeme, odoslané".
#
# Na Verceli: Project → Settings → Environment Variables.

# https://resend.com — bezplatná úroveň stačí
RESEND_API_KEY=

# Kam majú dopyty chodiť
CONTACT_TO=

# Odosielateľ. Musí to byť overená doména v Resende.
# Nepovinné — bez neho sa použije Resendova testovacia adresa.
CONTACT_FROM=
